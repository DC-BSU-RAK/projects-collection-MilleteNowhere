<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#121212"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:background="@drawable/button_selector"
            android:backgroundTint="@null"
            android:text="BACK"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/turret_road_bold"/>

        <ImageView
            android:id="@+id/memoryImage"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/nameText"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/turret_road_bold"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/typeText"
            android:textSize="20sp"
            android:textColor="#00C2A8"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/turret_road_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/powerText"
            android:textSize="18sp"
            android:fontFamily="@font/turret_road_bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/usageText"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/turret_road_bold"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/appearanceText"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/turret_road_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/notableFormText"
            android:textSize="18sp"
            android:textColor="#00C2A8"
            android:fontFamily="@font/turret_road_bold"
            android:layout_marginTop="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/setFavoriteButton"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@drawable/button_selector"
            android:backgroundTint="@null"
            android:text="SET FAVORITE"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/turret_road_bold"/>

    </LinearLayout>
</ScrollView>