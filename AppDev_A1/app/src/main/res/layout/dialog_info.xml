<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1B1B2F"
    android:gravity="center">

    <!-- Title -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/audiowide"
        android:text="DOUBLE DRIVER MANUAL"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Instructions -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/dotgothic16"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Insert two Gaia Memories.\n\nLeft Column: Soul Memories\nRight Column: Body Memories\n\nPress HENSHIN to initiate transformation.\n\n And one last memory hides from us..."
        android:textColor="#CCCCCC"
        android:textSize="15sp" />

    <!-- Close Button -->

    <Button
        android:id="@+id/btnClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#005AC1"
        android:fontFamily="@font/audiowide"
        android:text="Return to Driver"
        android:textAllCaps="true"
        android:textColor="#FFFFFF" />
</LinearLayout>